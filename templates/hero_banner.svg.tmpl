
    <linearGradient id="tank-water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0e172c"/>
      <stop offset="55%" stop-color="#162442"/>
      <stop offset="100%" stop-color="#191834"/>
    </linearGradient>
    <linearGradient id="tank-sheen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08"/>
      <stop offset="45%" stop-color="#47bfff" stop-opacity="0.02"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="caustic" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#7ee0ff" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#47bfff" stop-opacity="0"/>
    </linearGradient>
    <clipPath id="${tank_clip_id}">
      <rect x="${tank_x}" y="${tank_y}" width="${tank_width}" height="${tank_height}" rx="${tank_rx}"/>
    </clipPath>
    <style>
      .anim { will-change: transform, opacity; }
      .swim-r { animation: swim-r 12s linear infinite; }
      .swim-l { animation: swim-l 12s linear infinite; }
      .minnow-r { animation: minnow-r 9s linear infinite; }
      .tail-wag { transform-box: fill-box; transform-origin: 100% 50%; animation: tail-wag 0.8s ease-in-out infinite; }
      .kelp-sway { transform-box: fill-box; transform-origin: 50% 100%; animation: kelp-sway 6s ease-in-out infinite; }
      .bubble-rise { animation: bubble-rise 5.5s ease-in infinite; }
      .caustic-drift { animation: caustic-drift 9s ease-in-out infinite; }
      .cat-tail { transform-box: fill-box; transform-origin: 10% 90%; animation: cat-tail 4.2s ease-in-out infinite; }
      .cat-blink { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 5.4s ease-in-out infinite; }
      .cat-ear { transform-box: fill-box; transform-origin: 40% 95%; animation: cat-ear 6.8s ease-in-out infinite; }
      .cat-paw { transform-box: fill-box; transform-origin: 85% 50%; animation: cat-paw 4.8s ease-in-out infinite; }
      @keyframes swim-r {
        0% { transform: translate(-110px, 0px); opacity: 0; }
        14% { transform: translate(-65px, -4px); opacity: 0.95; }
        50% { transform: translate(20px, -7px); opacity: 1; }
        84% { transform: translate(110px, 3px); opacity: 0.95; }
        100% { transform: translate(145px, 5px); opacity: 0; }
      }
      @keyframes swim-l {
        0% { transform: translate(115px, 0px); opacity: 0; }
        14% { transform: translate(70px, 4px); opacity: 0.95; }
        50% { transform: translate(-20px, 6px); opacity: 1; }
        84% { transform: translate(-110px, -3px); opacity: 0.95; }
        100% { transform: translate(-150px, -5px); opacity: 0; }
      }
      @keyframes minnow-r {
        0% { transform: translate(-75px, 2px); opacity: 0; }
        18% { transform: translate(-30px, -3px); opacity: 0.72; }
        55% { transform: translate(55px, 3px); opacity: 0.78; }
        86% { transform: translate(125px, -2px); opacity: 0.65; }
        100% { transform: translate(160px, 1px); opacity: 0; }
      }
      @keyframes tail-wag {
        0%, 100% { transform: rotate(-10deg); }
        50% { transform: rotate(10deg); }
      }
      @keyframes kelp-sway {
        0%, 100% { transform: rotate(-4deg); }
        50% { transform: rotate(5deg); }
      }
      @keyframes bubble-rise {
        0% { transform: translateY(0px); opacity: 0; }
        18% { opacity: 0.85; }
        82% { opacity: 0.65; }
        100% { transform: translateY(-98px); opacity: 0; }
      }
      @keyframes caustic-drift {
        0%, 100% { transform: translateX(-8px); opacity: 0.08; }
        50% { transform: translateX(12px); opacity: 0.16; }
      }
      @keyframes cat-tail {
        0%, 100% { transform: rotate(-6deg); }
        50% { transform: rotate(9deg); }
      }
      @keyframes cat-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.1); }
      }
      @keyframes cat-ear {
        0%, 84%, 100% { transform: rotate(0deg); }
        88% { transform: rotate(-10deg); }
        92% { transform: rotate(3deg); }
      }
      @keyframes cat-paw {
        0%, 70%, 100% { transform: rotate(0deg); }
        78% { transform: rotate(-11deg); }
        85% { transform: rotate(4deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; opacity: 0.92 !important; }
      }
    </style>
