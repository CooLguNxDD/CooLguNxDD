
    <style>
      .anim { will-change: transform, opacity; }
      .cat-tail { transform-box: fill-box; transform-origin: 10% 90%; animation: cat-tail 2.4s ease-in-out infinite; }
      .cat-blink { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 4.8s ease-in-out infinite; }
      .cat-ear { transform-box: fill-box; transform-origin: 40% 95%; animation: cat-ear 5.5s ease-in-out infinite; }
      .catch-hop { transform-box: fill-box; transform-origin: 50% 100%; animation: catch-hop 2.2s ease-in-out infinite; }
      .cat-head { transform-box: fill-box; transform-origin: 50% 85%; animation: cat-head 2.2s ease-in-out infinite; }
      .cat-pupils { animation: cat-pupils 2.2s ease-in-out infinite; }
      .catch-paw { transform-box: fill-box; transform-origin: 15% 65%; animation: catch-paw 2.2s ease-in-out infinite; }
      .catch-fish { animation: catch-fish 2.2s ease-in-out infinite; }
      .splash-pop { animation: splash-pop 2.2s ease-out infinite; }
      @keyframes cat-tail {
        0%, 100% { transform: rotate(-9deg); }
        50% { transform: rotate(12deg); }
      }
      @keyframes cat-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.1); }
      }
      @keyframes cat-ear {
        0%, 84%, 100% { transform: rotate(0deg); }
        88% { transform: rotate(-10deg); }
        92% { transform: rotate(4deg); }
      }
      @keyframes catch-hop {
        0%, 100% { transform: translate(0px, 0px); }
        40% { transform: translate(8px, -7px); }
        60% { transform: translate(10px, -4px); }
      }
      @keyframes cat-head {
        0%, 100% { transform: rotate(2deg); }
        42% { transform: rotate(-5deg); }
        70% { transform: rotate(0deg); }
      }
      @keyframes cat-pupils {
        0%, 100% { transform: translate(1.2px, 0.7px); }
        42% { transform: translate(0.7px, -1.3px); }
        70% { transform: translate(1.1px, -0.3px); }
      }
      @keyframes catch-paw {
        0%, 100% { transform: rotate(8deg); }
        42% { transform: rotate(-34deg); }
        62% { transform: rotate(-18deg); }
      }
      @keyframes catch-fish {
        0%, 100% { transform: translate(0px, 4px); opacity: 0.78; }
        42% { transform: translate(-12px, -26px); opacity: 1; }
        70% { transform: translate(-2px, -8px); opacity: 0.95; }
      }
      @keyframes splash-pop {
        0%, 25% { transform: translateY(4px); opacity: 0; }
        45% { transform: translateY(-5px); opacity: 0.95; }
        85%, 100% { transform: translateY(-10px); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; opacity: 0.92 !important; }
      }
    </style>
