      }
      @keyframes play-hop {
        0%, 100% { transform: translateY(0px); }
        45% { transform: translateY(-3px); }
        70% { transform: translateY(0px); }
      }
      @keyframes cat-bat {
        0%, 100% { transform: rotate(0deg); }
        42% { transform: rotate(-22deg); }
        60% { transform: rotate(8deg); }
      }
      @keyframes toy-swing {
        0%, 100% { transform: rotate(-12deg); }
        50% { transform: rotate(14deg); }
      }
      @keyframes cat-stretch {
        0%, 100% { transform: scaleX(1) scaleY(1); }
        50% { transform: scaleX(1.06) scaleY(0.95); }
      }
      @keyframes yarn-roll {
        0%, 100% { transform: translateX(0px) rotate(0deg); }
        50% { transform: translateX(10px) rotate(28deg); }
      }
      @keyframes groom-head {
        0%, 100% { transform: rotate(0deg); }
        45% { transform: rotate(9deg) translateY(2px); }
      }
      @keyframes groom-paw {
        0%, 100% { transform: rotate(0deg); }
        45% { transform: rotate(-22deg) translateY(-3px); }
      }
      @keyframes box-bob {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(4px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; opacity: 0.92 !important; }
      }
