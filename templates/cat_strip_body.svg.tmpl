
    <style>
      .anim { will-change: transform, opacity; }
      .stroll-path { animation: stroll-path 7.2s ease-in-out infinite; }
      .stroll-bob { animation: stroll-bob 0.65s ease-in-out infinite; }
      .leg-a { transform-box: fill-box; transform-origin: 50% 10%; animation: leg-a 0.65s ease-in-out infinite; }
      .leg-b { transform-box: fill-box; transform-origin: 50% 10%; animation: leg-b 0.65s ease-in-out infinite; }
      .cat-tail { transform-box: fill-box; transform-origin: 10% 90%; animation: cat-tail 3.6s ease-in-out infinite; }
      .cat-blink { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 5.0s ease-in-out infinite; }
      .cat-ear { transform-box: fill-box; transform-origin: 40% 95%; animation: cat-ear 6.2s ease-in-out infinite; }
      .loaf-breathe { transform-box: fill-box; transform-origin: 50% 100%; animation: loaf-breathe 3.8s ease-in-out infinite; }
      .nap-tail { transform-box: fill-box; transform-origin: 0% 50%; animation: nap-tail 4.8s ease-in-out infinite; }
      .zzz-1 { animation: zzz-float 2.8s ease-out infinite; }
      .zzz-2 { animation: zzz-float 2.8s ease-out 0.8s infinite; }
      .zzz-3 { animation: zzz-float 2.8s ease-out 1.6s infinite; }
      .play-hop { transform-box: fill-box; transform-origin: 50% 100%; animation: play-hop 1.9s ease-in-out infinite; }
      .cat-bat { transform-box: fill-box; transform-origin: 10% 50%; animation: cat-bat 1.9s ease-in-out infinite; }
      .toy-swing { transform-box: fill-box; transform-origin: 50% 0%; animation: toy-swing 1.9s ease-in-out infinite; }
      @keyframes stroll-path {
        0%, 100% { transform: translateX(-32px); }
        50% { transform: translateX(32px); }
      }
      @keyframes stroll-bob {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-2.5px); }
      }
      @keyframes leg-a {
        0%, 100% { transform: rotate(-12deg); }
        50% { transform: rotate(12deg); }
      }
      @keyframes leg-b {
        0%, 100% { transform: rotate(12deg); }
        50% { transform: rotate(-12deg); }
      }
      @keyframes cat-tail {
        0%, 100% { transform: rotate(-7deg); }
        50% { transform: rotate(9deg); }
      }
      @keyframes cat-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.1); }
      }
      @keyframes cat-ear {
        0%, 84%, 100% { transform: rotate(0deg); }
        88% { transform: rotate(-10deg); }
        92% { transform: rotate(3deg); }
      }
      @keyframes loaf-breathe {
        0%, 100% { transform: scaleY(1); }
        50% { transform: scaleY(1.03); }
      }
      @keyframes nap-tail {
        0%, 100% { transform: rotate(-3deg); }
        50% { transform: rotate(4deg); }
      }
      @keyframes zzz-float {
        0% { transform: translate(0px, 2px); opacity: 0; }
        25% { opacity: 0.9; }
        80% { opacity: 0.85; }
        100% { transform: translate(6px, -12px); opacity: 0; }
      }
      @keyframes play-hop {
        0%, 100% { transform: translateY(0px); }
        45% { transform: translateY(-3px); }
        70% { transform: translateY(0px); }
      }
      @keyframes cat-bat {
        0%, 100% { transform: rotate(0deg); }
        42% { transform: rotate(-22deg); }
        60% { transform: rotate(8deg); }
      }
      @keyframes toy-swing {
        0%, 100% { transform: rotate(-12deg); }
        50% { transform: rotate(14deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; opacity: 0.92 !important; }
      }
    </style>
