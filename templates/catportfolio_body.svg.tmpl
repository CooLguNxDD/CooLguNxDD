
    <linearGradient id="cp-fish" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="${accent_end}"/>
      <stop offset="100%" stop-color="${pill_cyan}"/>
    </linearGradient>
    <radialGradient id="cp-cat-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="${accent_start}" stop-opacity="0.24"/>
      <stop offset="100%" stop-color="${accent_start}" stop-opacity="0"/>
    </radialGradient>
    <style>
      .anim { will-change: transform, opacity; }
      .cat-tail { transform-box: fill-box; transform-origin: 10% 90%; animation: cat-tail 2.8s ease-in-out infinite; }
      .cat-blink { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 4.6s ease-in-out infinite; }
      .cat-ear { transform-box: fill-box; transform-origin: 40% 95%; animation: cat-ear 5.4s ease-in-out infinite; }
      .cat-breathe { transform-box: fill-box; transform-origin: 50% 100%; animation: cat-breathe 3.2s ease-in-out infinite; }
      .cat-head { transform-box: fill-box; transform-origin: 50% 85%; animation: cat-head 5.5s ease-in-out infinite; }
      .cat-pupils { animation: cat-pupils 5.5s ease-in-out infinite; }
      .cp-fish-bob { animation: cp-fish-bob 5.5s ease-in-out infinite; }
      .cp-fish-2 { animation: cp-fish-2 6.8s ease-in-out -2.2s infinite; }
      .tail-wag { transform-box: fill-box; transform-origin: 100% 50%; animation: tail-wag 0.55s ease-in-out infinite; }
      .cp-bubble { animation: cp-bubble 3.8s ease-in infinite; }
      @keyframes cat-tail {
        0%, 100% { transform: rotate(-10deg); }
        50% { transform: rotate(12deg); }
      }
      @keyframes cat-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.1); }
      }
      @keyframes cat-ear {
        0%, 84%, 100% { transform: rotate(0deg); }
        88% { transform: rotate(-11deg); }
        92% { transform: rotate(4deg); }
      }
      @keyframes cat-breathe {
        0%, 100% { transform: scaleY(1); }
        50% { transform: scaleY(1.028); }
      }
      @keyframes cat-head {
        0%, 100% { transform: rotate(1.5deg); }
        33% { transform: rotate(-2.5deg); }
        66% { transform: rotate(3deg); }
      }
      @keyframes cat-pupils {
        0%, 100% { transform: translate(1.2px, 0.2px); }
        33% { transform: translate(1.5px, -1.0px); }
        66% { transform: translate(0.7px, 0.7px); }
      }
      @keyframes cp-fish-bob {
        0%, 100% { transform: translate(0px, 0px); }
        33% { transform: translate(-22px, -12px); }
        66% { transform: translate(-8px, 6px); }
      }
      @keyframes cp-fish-2 {
        0%, 100% { transform: translate(0px, 0px); }
        50% { transform: translate(20px, -9px); }
      }
      @keyframes tail-wag {
        0%, 100% { transform: rotate(-13deg); }
        50% { transform: rotate(13deg); }
      }
      @keyframes cp-bubble {
        0% { transform: translateY(6px); opacity: 0; }
        25% { opacity: 0.85; }
        80% { opacity: 0.65; }
        100% { transform: translateY(-28px); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; }
      }
    </style>
