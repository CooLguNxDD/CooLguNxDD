
    <linearGradient id="cp-fish" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="${accent_end}"/>
      <stop offset="100%" stop-color="${pill_cyan}"/>
    </linearGradient>
    <radialGradient id="cp-cat-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="${accent_start}" stop-opacity="0.24"/>
      <stop offset="100%" stop-color="${accent_start}" stop-opacity="0"/>
    </radialGradient>
    <style>
      .anim { will-change: transform, opacity; }
      .cat-tail { transform-box: fill-box; transform-origin: 10% 90%; animation: cat-tail 4.0s ease-in-out infinite; }
      .cat-blink { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 5.2s ease-in-out infinite; }
      .cat-ear { transform-box: fill-box; transform-origin: 40% 95%; animation: cat-ear 6.5s ease-in-out infinite; }
      .cat-breathe { transform-box: fill-box; transform-origin: 50% 100%; animation: cat-breathe 3.8s ease-in-out infinite; }
      .cp-fish-bob { animation: cp-fish-bob 4.4s ease-in-out infinite; }
      .tail-wag { transform-box: fill-box; transform-origin: 100% 50%; animation: tail-wag 0.85s ease-in-out infinite; }
      .cp-bubble { animation: cp-bubble 4.2s ease-in-out infinite; }
      @keyframes cat-tail {
        0%, 100% { transform: rotate(-6deg); }
        50% { transform: rotate(9deg); }
      }
      @keyframes cat-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.1); }
      }
      @keyframes cat-ear {
        0%, 84%, 100% { transform: rotate(0deg); }
        88% { transform: rotate(-10deg); }
        92% { transform: rotate(3deg); }
      }
      @keyframes cat-breathe {
        0%, 100% { transform: scaleY(1); }
        50% { transform: scaleY(1.022); }
      }
      @keyframes cp-fish-bob {
        0%, 100% { transform: translate(0px, 0px); }
        50% { transform: translate(-4px, -4px); }
      }
      @keyframes tail-wag {
        0%, 100% { transform: rotate(-10deg); }
        50% { transform: rotate(10deg); }
      }
      @keyframes cp-bubble {
        0%, 100% { transform: translateY(0px); opacity: 0.3; }
        50% { transform: translateY(-7px); opacity: 0.85; }
      }
      @media (prefers-reduced-motion: reduce) {
        .anim { animation: none !important; }
      }
    </style>
<!-- BODY -->
