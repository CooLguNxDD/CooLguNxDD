    "ring_arc": "  <circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"url(#ring)\" stroke-width=\"${stroke_width}\" stroke-linecap=\"round\" stroke-dasharray=\"${dash_len} ${circumference}\" transform=\"rotate(-90 ${cx} ${cy})\"/>",
    "spark_bar": "  <rect x=\"${x}\" y=\"${y}\" width=\"${width}\" height=\"${height}\" rx=\"${rx}\" fill=\"${fill}\"/>",
    "lang_segment": "    <rect x=\"${x}\" y=\"${y}\" width=\"${width}\" height=\"${height}\" fill=\"${color}\"/>",
    "lang_legend_item": "  <circle cx=\"${cx}\" cy=\"${cy}\" r=\"${dot_r}\" fill=\"${color}\"/>\n  <text x=\"${name_x}\" y=\"${y}\" font-family=\"${font_family}\" font-size=\"12\" fill=\"${text_primary}\">${name}</text>\n  <text x=\"${pct_x}\" y=\"${y}\" text-anchor=\"end\" font-family=\"${font_family}\" font-size=\"11.5\" fill=\"${text_secondary}\">${pct}</text>"
  }
}
